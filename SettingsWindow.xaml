<Window x:Class="Ketch.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        Title="Settings" Height="420" Width="360" WindowStartupLocation="CenterScreen">
    <StackPanel Margin="12" VerticalAlignment="Top">
        <TextBlock Text="Background Color" FontWeight="Bold" />
        <ComboBox x:Name="cbBackground" Margin="0,4" />

        <TextBlock Text="Font Color" FontWeight="Bold" Margin="0,8,0,0" />
        <ComboBox x:Name="cbFont" Margin="0,4" />

        <TextBlock Text="Opacity" FontWeight="Bold" Margin="0,8,0,0" />
        <ComboBox x:Name="cbOpacity" Margin="0,4" />

        <TextBlock Text="Size" FontWeight="Bold" Margin="0,8,0,0" />
        <ComboBox x:Name="cbSize" Margin="0,4" />

        <TextBlock Text="Display Location" FontWeight="Bold" Margin="0,8,0,0" />
        <ComboBox x:Name="cbLocation" Margin="0,4" />

        <TextBlock Text="Time Format" FontWeight="Bold" Margin="0,8,0,0" />
        <ComboBox x:Name="cbTimeFormat" Margin="0,4" />

        <StackPanel Orientation="Horizontal" Margin="0,10">
            <CheckBox x:Name="chkSeconds" Content="Show Seconds" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="btnOk" Width="80" Margin="4" Click="BtnOk_Click">OK</Button>
            <Button x:Name="btnCancel" Width="80" Margin="4" Click="BtnCancel_Click">Cancel</Button>
        </StackPanel>
    </StackPanel>
</Window>
