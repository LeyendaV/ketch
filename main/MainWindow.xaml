<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="Ketch.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ketch"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Loaded="Window_Loaded">
    <Border x:Name="RootBorder" Background="Transparent" Padding="20">
        <Grid x:Name="ClockGrid" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        </Grid>
    </Border>
</Window>
